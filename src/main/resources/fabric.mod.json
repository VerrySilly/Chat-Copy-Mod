{
	"schemaVersion": 1,
	"id": "vanillah-mod",
	"version": "${version}",
	"name": "Chat Copy",
	"description": "Adds a blue (copy) button after every chat message. Click it to copy the message.",
	"authors": [
		"VerrySilly"
	],
	"contact": {
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/vanillah-mod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.vanillah.ChatCopy"
		],
		"client": [
			"com.vanillah.client.ChatCopyClient"
		]
	},
	"mixins": [
		"vanillah-mod.mixins.json",
		{
			"config": "vanillah-mod.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.2",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}